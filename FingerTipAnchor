using UnityEngine;

public class FingertipAnchor : MonoBehaviour
{
    [Tooltip("Drag your AR_Nail prefab here")]
    public GameObject nailPrefab;

    [Tooltip("Lower = smoother but lags. Higher = faster but more jitter.")]
    public float smoothSpeed = 15f;

    private GameObject[] spawnedNails = new GameObject[5];
    // We need a place to store the target coordinates MediaPipe sends
    private Vector3[] targetPositions = new Vector3[5];

    void Start()
    {
        for (int i = 0; i < 5; i++)
        {
            spawnedNails[i] = Instantiate(nailPrefab);
            spawnedNails[i].SetActive(false);
        }
    }

    // MediaPipe sends the live coordinates here
    public void MoveNail(int fingerID, Vector3 newTargetPosition)
    {
        spawnedNails[fingerID].SetActive(true);
        targetPositions[fingerID] = newTargetPosition; // Store it, don't snap to it yet
    }

    // Unity runs this 60 times a second to glide the nails
    void Update()
    {
        for (int i = 0; i < 5; i++)
        {
            if (spawnedNails[i] != null && spawnedNails[i].activeSelf)
            {
                // Vector3.Lerp calculates a smooth glide from current position to target position
                spawnedNails[i].transform.position = Vector3.Lerp(
                    spawnedNails[i].transform.position,
                    targetPositions[i],
                    Time.deltaTime * smoothSpeed
                );
            }
        }
    }
}
